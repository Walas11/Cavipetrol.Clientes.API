-- =========================
-- SP: Obtener cliente por identificación
-- =========================
CREATE PROCEDURE sp_ObtenerCliente
    @Identificacion VARCHAR(20)
AS
BEGIN
    SET NOCOUNT ON;

    SELECT
        ClienteID,
        Identificacion,
        Nombre,
        Apellido,
        Email,
        Telefono,
        Direccion,
        FechaRegistro
    FROM Clientes
    WHERE Identificacion = @Identificacion;
END;
GO

